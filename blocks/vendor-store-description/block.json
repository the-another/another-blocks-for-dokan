{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "the-another/blocks-for-dokan-vendor-store-description",
	"title": "Vendor Store Description",
	"category": "dokan",
	"ancestor": [ "the-another/blocks-for-dokan-vendor-query-loop", "the-another/blocks-for-dokan-vendor-card", "the-another/blocks-for-dokan-vendor-store-banner", "the-another/blocks-for-dokan-product-vendor-info" ],
	"icon": "editor-paragraph",
	"description": "Display the vendor's store description.",
	"keywords": [ "dokan", "vendor", "store", "description", "about", "bio" ],
	"textdomain": "the-another-blocks-for-dokan",
	"usesContext": [ "dokan/vendor" ],
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"allowHtml": {
			"type": "boolean",
			"default": true
		},
		"showLabel": {
			"type": "boolean",
			"default": true
		},
		"label": {
			"type": "string",
			"default": "Description"
		}
	}
}
